name = "voice-synth-archive-worker"
main = "niconico-worker.js"
compatibility_date = "2026-01-01"

# Create a D1 database, then fill in its IDs.
# Binding name must stay "DB" because the worker uses env.DB.
[[d1_databases]]
binding = "DB"
database_name = "voice-synth-detective"
database_id = "PUT_YOUR_D1_DATABASE_ID_HERE"

# Optional but recommended: gradually warm the local song index.
# 50 VocaDB Original songs are indexed per run.
[triggers]
crons = ["*/15 * * * *"]
