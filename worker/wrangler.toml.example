name = "voice-synth-archive-worker"
main = "niconico-worker.js"
compatibility_date = "2026-09-01"

# ===== FREE MODE =====
# Only D1 + ordinary Worker requests are required.
[vars]
ENABLE_AI = "0"

[[d1_databases]]
binding = "DB"
database_name = "voice-synth-detective"
database_id = "PUT_YOUR_D1_DATABASE_ID_HERE"

# Free-tier-friendly ingestion:
# 50 VocaDB rows per run, four runs per day.
[triggers]
crons = ["0 */6 * * *"]

# Optional manual sync endpoint:
# POST /detective/sync with Authorization: Bearer <SYNC_TOKEN>
# Keep this as a Worker secret:
# npx wrangler secret put SYNC_TOKEN

# ===== LATER PAID/AI UPGRADE =====
# When you decide to upgrade, change ENABLE_AI to "1" and add:
#
# [ai]
# binding = "AI"
#
# [[vectorize]]
# binding = "VECTORIZE"
# index_name = "voice-synth-semantic"
#
# [[vectorize]]
# binding = "VISUALIZE"
# index_name = "voice-synth-visual"
#
# The application code already supports those bindings; no detective rewrite is required.
