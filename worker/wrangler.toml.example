name = "voice-synth-archive-worker"
main = "niconico-worker.js"
compatibility_date = "2026-09-01"

[[d1_databases]]
binding = "DB"
database_name = "voice-synth-detective"
database_id = "PUT_YOUR_D1_DATABASE_ID_HERE"

# Workers AI multilingual embedding binding.
[ai]
binding = "AI"

# Create first:
# npx wrangler@latest vectorize create voice-synth-semantic --dimensions=1024 --metric=cosine
[[vectorize]]
binding = "VECTORIZE"
index_name = "voice-synth-semantic"

# MV/thumbnail visual-semantic index.
# Candidate thumbnails are captioned by a vision model, then embedded with bge-m3.
# Create:
# npx wrangler@latest vectorize create voice-synth-visual --dimensions=1024 --metric=cosine
[[vectorize]]
binding = "VISUALIZE"
index_name = "voice-synth-visual"

# Gradually fills D1 and Vectorize. Four 50-song VocaDB pages are processed per run.
[triggers]
crons = ["*/15 * * * *"]

# Optional manual sync endpoint:
# POST /detective/sync with Authorization: Bearer <SYNC_TOKEN>
# Set this as a Worker secret, do not hardcode it:
# npx wrangler secret put SYNC_TOKEN
